---
import Layout from '../layouts/Layout.astro';
import hackathons from '../content/hackathons.json';

const isWin = (status: string) => status !== "didn't qualify" && status !== 'pending';
const winCount = hackathons.filter((h) => isWin(h.status)).length;
---
<Layout title="Events — HyperZx2O">

  <section class="events-hero section">
    <div class="container">
      <p class="section-tag mono-label">Stages</p>
      <h1 class="display-md">Events</h1>
      <p class="body-lg muted">Every stage I've been on — {hackathons.length} stages, {winCount} podiums.</p>
    </div>
  </section>

  <section class="events-timeline">
    <div class="container">
      <div class="filter-bar" role="toolbar" aria-label="Filter events by outcome">
        <div class="filter-indicator"></div>
        <button class="filter-chip mono-label active" data-filter="all" aria-pressed="true">All ({hackathons.length})</button>
        <button class="filter-chip mono-label" data-filter="wins" aria-pressed="false">Wins & Finals ({winCount})</button>
        <button class="filter-chip mono-label" data-filter="rest" aria-pressed="false">Participations ({hackathons.length - winCount})</button>
      </div>
      <div class="sr-only" aria-live="polite" aria-atomic="true" id="filter-status"></div>
      <div class="timeline">
        <div class="timeline-track" aria-hidden="true">
          <div class="timeline-line"></div>
        </div>
        {hackathons.map((h, i) => (
          <article class="timeline-item" data-index={i} data-group={isWin(h.status) ? 'wins' : 'rest'}>
            <div class="timeline-left">
              <span class="timeline-date mono-label">{h.date}</span>
            </div>
            <div class="timeline-dot" aria-hidden="true"></div>
            <div class="timeline-card stack-hover min-w-0 card-spotlight-active">
              <div class="card-spotlight" aria-hidden="true"></div>
              <div class="card-top">
                <h2 class="event-name heading-3 text-truncate">{h.event}</h2>
                <span class={`status-badge mono-label ${h.status === 'finalist' || (h.status !== 'pending' && h.status !== "didn't qualify") ? 'status--finalist' : h.status === 'pending' ? 'status--pending' : 'status--no'}`}>{h.status === 'finalist' ? 'Finalist' : h.status === 'pending' ? 'Pending' : h.status === "didn't qualify" ? 'Participated' : h.status}</span>
              </div>
              {h.projectUrl ? (
                <a href={h.projectUrl} target="_blank" rel="noopener" class="project-name mono-label">{h.project} →</a>
              ) : (
                <span class="project-name project-name--plain mono-label">{h.project}</span>
              )}
              <p class="team-names">{h.team}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  .events-hero .display-md {
    margin-bottom: var(--space-lg);
  }

  /* Timeline */
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }

  /* Continuous line track */
  .timeline-track {
    display: none;
  }
  @media (min-width: 768px) {
    .timeline-track {
      display: block;
      position: absolute;
      left: 120px;
      top: 0;
      bottom: 0;
      width: 1px;
      margin-left: 0;
      transform: translateX(-0.5px);
    }
    .timeline-line {
      width: 100%;
      height: 100%;
      background: var(--color-border-subtle);
      transform-origin: top;
      transform: scaleY(0);
      transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .timeline.is-visible .timeline-line {
      transform: scaleY(1);
    }
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    opacity: 0;
    transform: translateX(var(--slide-from, 0px));
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }
  .timeline-item.is-visible {
    opacity: 1;
    transform: translateX(0);
  }
  @media (min-width: 768px) {
    .timeline-item {
      grid-template-columns: 120px 7px 1fr;
      gap: var(--space-xl);
      align-items: start;
    }
    .timeline-item[data-index="0"],
    .timeline-item[data-index="2"],
    .timeline-item[data-index="4"],
    .timeline-item[data-index="6"],
    .timeline-item[data-index="8"] {
      --slide-from: -40px;
    }
    .timeline-item[data-index="1"],
    .timeline-item[data-index="3"],
    .timeline-item[data-index="5"],
    .timeline-item[data-index="7"],
    .timeline-item[data-index="9"] {
      --slide-from: 40px;
    }
  }

  .timeline-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .timeline-date {
    color: var(--color-accent);
    font-size: var(--text-xs);
    padding-top: var(--space-xs);
  }

  /* Filter bar */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-3xl);
    position: relative;
  }
  .filter-indicator {
    position: absolute;
    bottom: 0;
    height: 2px;
    background: var(--color-accent);
    transition: left 200ms var(--ease-out), width 200ms var(--ease-out);
    pointer-events: none;
  }
  .filter-chip {
    background: transparent;
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
    padding: var(--space-sm) var(--space-lg);
    font-size: var(--text-xs);
    transition: border-color var(--transition-instant), color var(--transition-instant), background var(--transition-instant);
    position: relative;
  }
  .filter-chip:hover,
  .filter-chip.active {
    border-color: var(--color-accent);
    color: var(--color-primary);
    background: var(--color-accent);
  }
  .filter-chip:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .timeline-item[data-hidden="true"] {
    display: none;
  }

  /* Dot */
  .timeline-dot {
    display: none;
  }
  @media (min-width: 768px) {
    .timeline-dot {
      display: block;
      width: 7px;
      height: 7px;
      border-radius: var(--radius-full);
      background: var(--color-text-muted);
      margin-top: 6px;
      position: relative;
      z-index: 2;
      transition: transform 200ms var(--ease-out), box-shadow 200ms var(--ease-out), background 200ms var(--ease-out);
    }
    .timeline-item:has(.status--finalist) .timeline-dot {
      background: var(--color-accent);
    }
    .timeline-item.is-dot-active .timeline-dot {
      transform: scale(1.8);
      box-shadow: 0 0 12px rgba(237, 255, 69, 0.5);
      background: var(--color-accent);
    }
  }

  /* Card */
  .timeline-card {
    border: 1px solid var(--color-border-subtle);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    position: relative;
    overflow: hidden;
    perspective: 800px;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: border-color var(--transition-instant), transform var(--transition-fast);
  }
  .timeline-card:hover {
    border-color: var(--color-accent);
  }
  .timeline-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .timeline-card > * {
    position: relative;
    z-index: 1;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .event-name {
    color: var(--color-text);
    flex: 1;
  }

  /* Status badges */
  .status-badge {
    flex-shrink: 0;
    padding: var(--space-xs) var(--space-md);
    font-size: var(--text-xs);
    white-space: nowrap;
  }
  .status--finalist {
    background: var(--color-accent);
    color: var(--color-primary);
  }
  .status--pending {
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border-subtle);
  }
  .status--no {
    background: transparent;
    color: var(--color-text-muted);
  }

  /* Project name */
  .project-name {
    color: var(--color-accent);
    font-size: var(--text-xs);
    display: inline-block;
    transition: opacity var(--transition-instant);
  }
  .project-name:hover {
    opacity: 0.8;
  }
  .project-name--plain {
    cursor: default;
  }

  /* Team */
  .team-names {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-line {
      transition: none !important;
      transform: scaleY(1) !important;
    }
    .timeline-item {
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .timeline-card {
      transition: border-color var(--transition-instant) !important;
      transform: none !important;
    }
    .timeline-dot {
      transition: none !important;
    }
  }
</style>

<script>
  // Scroll-triggered line draw
  const timeline = document.querySelector('.timeline');
  if (timeline) {
    const lineObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            timeline.classList.add('is-visible');
          }
        });
      },
      { threshold: 0.1 }
    );
    lineObserver.observe(timeline);
  }

  // Staggered card entrance
  const items = document.querySelectorAll('.timeline-item');
  const cardObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );
  items.forEach(item => cardObserver.observe(item));

  // Hover dot connection
  const cards = document.querySelectorAll('.timeline-card');
  cards.forEach(card => {
    const item = card.closest('.timeline-item');
    if (!item) return;
    card.addEventListener('mouseenter', () => item.classList.add('is-dot-active'));
    card.addEventListener('mouseleave', () => item.classList.remove('is-dot-active'));
  });

  // Outcome filter
  const chips = document.querySelectorAll('.filter-chip');
  const timelineItems = document.querySelectorAll('.timeline-item');
  const indicator = document.querySelector('.filter-indicator') as HTMLElement;

  function moveIndicator(chip: Element) {
    if (!indicator) return;
    const rect = chip.getBoundingClientRect();
    const barRect = chip.parentElement!.getBoundingClientRect();
    indicator.style.left = `${rect.left - barRect.left}px`;
    indicator.style.width = `${rect.width}px`;
  }

  function updateFilterStatus() {
    const visible = document.querySelectorAll('.timeline-item:not([data-hidden="true"])');
    const status = document.getElementById('filter-status');
    if (status) {
      status.textContent = visible.length + ' of ' + timelineItems.length + ' events shown';
    }
  }

  const startChip = document.querySelector('.filter-chip.active');
  if (startChip) moveIndicator(startChip);
  window.addEventListener('resize', () => {
    const active = document.querySelector('.filter-chip.active');
    if (active) moveIndicator(active);
  });

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      chips.forEach(c => {
        c.classList.remove('active');
        c.setAttribute('aria-pressed', 'false');
      });
      chip.classList.add('active');
      chip.setAttribute('aria-pressed', 'true');
      moveIndicator(chip);

      const filter = chip.getAttribute('data-filter');
      timelineItems.forEach(item => {
        const group = item.getAttribute('data-group');
        const show = filter === 'all' || group === filter;
        if (show) {
          item.removeAttribute('data-hidden');
          (item as HTMLElement).style.display = '';
        } else {
          item.setAttribute('data-hidden', 'true');
          (item as HTMLElement).style.display = 'none';
        }
      });
      updateFilterStatus();
    });
  });

  // Tilt + spotlight
  cards.forEach(card => {
    card.addEventListener('mousemove', (e: MouseEvent) => (window as any).applyTilt(e));
    card.addEventListener('mouseleave', (e: MouseEvent) => (window as any).resetTilt(e));
    card.addEventListener('touchstart', (e: MouseEvent) => (window as any).resetTilt(e));
  });
</script>
