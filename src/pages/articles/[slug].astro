---
import Layout from '../../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { headings } = await render(article);

const meta = article.data;
const dateLabel = new Date(`${meta.date}-01T00:00:00`).toLocaleDateString('en-GB', {
  month: 'long',
  year: 'numeric',
});

/**
 * Promote `<p><img></p><p><em>caption</em></p>` into a real
 * <figure><img><figcaption> triple so captions are semantic rather than
 * inferred from a sibling `:only-child` selector.
 */
const html = (article.rendered?.html ?? '').replace(
  /<p>\s*(<img\b[^>]*>)\s*<\/p>\s*<p>\s*<em>([\s\S]*?)<\/em>\s*<\/p>/g,
  '<figure>$1<figcaption>$2</figcaption></figure>'
);

const coverAssets = import.meta.glob('../../../articles/*/*.{jpg,jpeg,png,webp,avif}', { eager: true }) as Record<string, { default: ImageMetadata }>;
const pdfAssets = import.meta.glob('../../../articles/*/*.pdf', { eager: true, query: '?url', import: 'default' }) as Record<string, string>;

const coverSrc = coverAssets[`../../../articles/${article.id}/${meta.cover}`].default;
const pdfUrl = pdfAssets[`../../../articles/${article.id}/${meta.pdf}`];

const toc = headings.filter((h) => h.depth === 2);
const base = import.meta.env.BASE_URL;
---

<Layout
  title={`${meta.title} — HyperZx2O`}
  description={`${meta.title} by MD. Sadman Saif Zarif, published in ${meta.publication}, ${meta.publisher}, ${dateLabel}.`}
>
  <article class="article">
    <div class="article-inner">
      <a href={`${base}guides/`} class="article-back mono-label">← Writing</a>

      <header class="article-head">
        <p class="article-pub mono-label">{meta.publication} · {meta.publisher}</p>
        <h1 class="article-title">{meta.title}</h1>
        <p class="article-date mono-label">{dateLabel}</p>
        <ul class="article-tags">
          {meta.tags.map((tag) => <li class="tech-tag mono-label">{tag}</li>)}
        </ul>
      </header>

      <div class="article-hero">
        <Picture
          src={coverSrc}
          widths={[640, 1024, 1600]}
          formats={['avif', 'webp']}
          sizes="(max-width: 768px) 100vw, 900px"
          alt={meta.title}
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="article-grid">
        <div class="article-prose" set:html={html} />

        {toc.length > 0 && (
          <aside class="article-toc" aria-label="On this page">
            <p class="article-toc-title mono-label">On this page</p>
            <ul>
              {toc.map((h) => (
                <li><a href={`#${h.slug}`} class="mono-label">{h.text}</a></li>
              ))}
            </ul>
          </aside>
        )}
      </div>

      <footer class="article-foot">
        <a href={pdfUrl} download class="article-pdf mono-label">Original PDF ↓</a>
        <a href={`${base}guides/`} class="article-more mono-label">More writing →</a>
      </footer>
    </div>
  </article>
</Layout>

<style>
  .article {
    padding: calc(var(--nav-h) + var(--space-3xl)) 0 var(--space-4xl);
  }
  .article-inner {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: var(--space-lg);
  }
  .article-back {
    color: var(--color-text-muted);
    display: inline-block;
    padding: var(--space-md) 0;
  }
  .article-back:hover {
    color: var(--color-accent);
  }

  .article-head {
    max-width: 720px;
    margin-bottom: var(--space-2xl);
  }
  .article-pub {
    color: var(--color-accent);
  }
  .article-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin: var(--space-md) 0 var(--space-md);
  }
  .article-date {
    color: var(--color-text-muted);
  }
  .article-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .article-hero {
    margin-bottom: var(--space-3xl);
    border: 1px solid var(--color-border-subtle);
    overflow: hidden;
  }
  .article-hero :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .article-grid {
    display: grid;
    gap: var(--space-3xl);
  }
  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: minmax(0, 1fr) var(--measure-aside);
      align-items: start;
    }
  }

  /* ── Long-form reading ─────────────────────────────────────────── */
  .article-prose {
    max-width: var(--measure-prose);
    font-family: var(--font-prose);
    font-size: var(--text-prose);
    font-weight: 400;
    line-height: var(--leading-prose);
    color: var(--color-text);
    hanging-punctuation: first last;
  }
  .article-prose :global(p) {
    margin-bottom: var(--space-lg);
    text-wrap: pretty;
    orphans: 3;
    widows: 3;
  }
  /* Opening paragraph gets presence without a drop cap swallowing the
     first word of a caption-less article. */
  .article-prose > :global(p:first-of-type) {
    font-size: var(--text-lg);
    line-height: 1.65;
    color: var(--color-text);
  }
  .article-prose > :global(p:first-of-type)::first-line {
    font-weight: 500;
  }

  .article-prose :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin: var(--space-3xl) 0 var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border-subtle);
  }
  .article-prose :global(h3) {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.3;
    text-wrap: balance;
    margin: var(--space-2xl) 0 var(--space-md);
  }
  .article-prose :global(h4) {
    font-family: var(--font-rules);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: var(--space-xl) 0 var(--space-sm);
  }

  .article-prose :global(ul),
  .article-prose :global(ol) {
    margin: 0 0 var(--space-lg);
    padding-left: 1.35em;
  }
  .article-prose :global(li) {
    margin-bottom: var(--space-sm);
    text-wrap: pretty;
  }
  .article-prose :global(li)::marker) {
    color: var(--color-accent);
    font-size: 0.9em;
  }
  /* Hanging indent so wrapped reference lines align under the citation,
     not under the number. */
  .article-prose :global(ol > li) {
    padding-left: 0.35em;
    text-indent: -0.35em;
    margin-bottom: var(--space-md);
    color: var(--color-text-muted);
    font-size: var(--text-prose-sm);
  }

  .article-prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: var(--color-border-subtle);
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
    transition: text-decoration-color var(--transition-instant);
  }
  .article-prose :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }
  .article-prose :global(strong) {
    font-weight: 700;
    color: var(--color-text);
  }
  .article-prose :global(em) {
    font-style: italic;
  }
  .article-prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border-subtle);
    margin: var(--space-3xl) 0;
  }
  .article-prose :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-lg);
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0 0 var(--space-lg);
  }
  .article-prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  /* Figures — semantic <figure>/<figcaption>, breaking slightly wider than
     the text column so diagrams stay legible. */
  .article-prose :global(figure) {
    margin: var(--space-2xl) 0;
    max-width: var(--measure-wide);
  }
  .article-prose :global(figure img) {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--color-border-subtle);
  }
  .article-prose :global(figcaption) {
    margin-top: var(--space-sm);
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .article-prose :global(p > img:only-child) {
    margin: var(--space-2xl) 0 var(--space-sm);
    border: 1px solid var(--color-border-subtle);
  }

  .article-toc {
    position: sticky;
    top: calc(var(--nav-h) + var(--space-lg));
    border-left: 1px solid var(--color-border-subtle);
    padding-left: var(--space-lg);
  }
  .article-toc-title {
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }
  .article-toc ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .article-toc a {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: 1.5;
  }
  .article-toc a:hover {
    color: var(--color-accent);
  }

  .article-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    align-items: center;
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border-subtle);
  }
  .article-pdf,
  .article-more {
    color: var(--color-accent);
    font-size: var(--text-xs);
    padding: var(--space-md) 0;
  }
  .article-more {
    color: var(--color-text-muted);
  }
  .article-more:hover {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .article-inner {
      padding-inline: var(--space-md);
    }
  }
</style>
