---
import Layout from '../layouts/Layout.astro';
import photos from '../content/photos.json';
const base = import.meta.env.BASE_URL;
const photosJs = JSON.stringify(photos.map(p => ({ ...p, src: base + p.src })));
---
<Layout title="Gallery — HyperZx2O">

  <section class="gallery-hero section">
    <div class="container">
      <p class="section-tag mono-label">Visual</p>
      <h1 class="display-lg">Gallery</h1>
      <p class="body-lg muted">Photography as a hobby. No genres, just frames.</p>
    </div>
  </section>

  <section class="gallery-grid-wrap">
    <div class="container">
      <div class="bento-grid">
        {photos.map((photo, i) => (
          <figure
            class:list={['bento-item', `bento-${photo.size}`]}
            data-index={i}
            style={`--i: ${i}`}
          >
            <img
              src={`${base}${photo.src}`}
              alt={photo.alt}
              width="800"
              height="500"
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <dialog class="lightbox" aria-label="Photo viewer">
    <button class="lightbox-close" aria-label="Close">×</button>
    <button class="lightbox-prev" aria-label="Previous photo">‹</button>
    <button class="lightbox-next" aria-label="Next photo">›</button>
    <figure class="lightbox-figure">
      <img class="lightbox-img" src="" alt="" />
    </figure>
    <figcaption class="lightbox-counter mono-label"></figcaption>
  </dialog>

</Layout>

<style>
  .gallery-hero .display-lg {
    margin-bottom: var(--space-lg);
  }

  /* Bento grid */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 180px;
    gap: 12px;
  }

  .bento-item {
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: 2px;
    margin: 0;
    position: relative;
    cursor: pointer;
    transition: border-color var(--transition-instant);
  }
  .bento-item:hover {
    border-color: var(--color-accent);
  }
  .bento-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-smooth);
  }
  .bento-item:hover img {
    transform: scale(1.03);
  }

  .bento-large {
    grid-column: span 2;
    grid-row: span 2;
  }
  .bento-medium {
    grid-column: span 2;
    grid-row: span 1;
  }
  .bento-small {
    grid-column: span 1;
    grid-row: span 1;
  }

  @media (max-width: 767px) {
    .bento-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 160px;
    }
    .bento-large {
      grid-column: span 2;
      grid-row: span 1;
    }
    .bento-medium {
      grid-column: span 1;
    }
  }
  @media (max-width: 480px) {
    .bento-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: 220px;
    }
    .bento-large,
    .bento-medium {
      grid-column: span 1;
      grid-row: span 1;
    }
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: rgba(0, 0, 242, 0.92);
    color: var(--color-text);
    z-index: 200;
    opacity: 0;
    transition: opacity 200ms ease-out;
  }
  .lightbox[open] {
    opacity: 1;
  }
  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox-figure {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: var(--space-3xl) var(--space-4xl);
  }
  .lightbox-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 2px;
    opacity: 0;
    transform: scale(0.95);
    transition: opacity 250ms ease-out, transform 250ms ease-out;
  }
  .lightbox[open] .lightbox-img {
    opacity: 1;
    transform: scale(1);
  }

  .lightbox-close {
    position: fixed;
    top: var(--space-lg);
    right: var(--space-lg);
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 1.5rem;
    cursor: pointer;
    z-index: 201;
    padding: var(--space-md);
    line-height: 1;
    transition: color var(--transition-instant);
  }
  .lightbox-close:hover,
  .lightbox-close:focus-visible {
    color: var(--color-text);
  }
  .lightbox-close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .lightbox-prev,
  .lightbox-next {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 2rem;
    cursor: pointer;
    z-index: 201;
    padding: var(--space-lg);
    line-height: 1;
    transition: color var(--transition-instant);
  }
  .lightbox-prev { left: var(--space-lg); }
  .lightbox-next { right: var(--space-lg); }
  .lightbox-prev:hover,
  .lightbox-next:hover,
  .lightbox-prev:focus-visible,
  .lightbox-next:focus-visible {
    color: var(--color-text);
  }
  .lightbox-prev:focus-visible,
  .lightbox-next:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .lightbox-counter {
    position: fixed;
    bottom: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    z-index: 201;
  }

  @media (max-width: 767px) {
    .lightbox-figure {
      padding: var(--space-3xl) var(--space-lg);
    }
    .lightbox-prev,
    .lightbox-next {
      display: none;
    }
    .lightbox-close {
      top: var(--space-md);
      right: var(--space-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox,
    .lightbox-img {
      transition: none;
    }
  }
</style>

<script is:inline set:html={`var photos = ${photosJs};`}></script>

<script is:inline>
  const dialog = document.querySelector('.lightbox');
  const img = dialog?.querySelector('.lightbox-img');
  const counter = dialog?.querySelector('.lightbox-counter');
  const prevBtn = dialog?.querySelector('.lightbox-prev');
  const nextBtn = dialog?.querySelector('.lightbox-next');
  const closeBtn = dialog?.querySelector('.lightbox-close');
  const items = document.querySelectorAll('.bento-item');

  let current = 0;
  let lastFocused = null;

  function getFocusableElements() {
    return dialog ? Array.from(dialog.querySelectorAll('button')).filter(el => el.offsetParent !== null) : [];
  }

  function trapFocus(e) {
    const focusable = getFocusableElements();
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  }

  function open(index) {
    current = index;
    lastFocused = document.activeElement;
    update();
    dialog.showModal();
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
    dialog.addEventListener('keydown', trapFocus);
  }

  function close() {
    dialog.close();
    document.body.style.overflow = '';
    dialog.removeEventListener('keydown', trapFocus);
    if (lastFocused) lastFocused.focus();
  }

  function update() {
    const photo = photos[current];
    img.src = photo.src;
    img.alt = photo.alt;
    counter.textContent = (current + 1) + ' / ' + photos.length;
    prevBtn.style.visibility = current === 0 ? 'hidden' : 'visible';
    nextBtn.style.visibility = current === photos.length - 1 ? 'hidden' : 'visible';
  }

  function prev() {
    if (current > 0) { current--; update(); }
  }

  function next() {
    if (current < photos.length - 1) { current++; update(); }
  }

  items.forEach(function(item) {
    item.addEventListener('click', function() {
      var index = Number(item.getAttribute('data-index'));
      open(index);
    });
  });

  // Image error fallback
  document.querySelectorAll('.bento-item img').forEach(function(img) {
    img.addEventListener('error', function() {
      this.classList.add('img-error');
      this.alt = 'Image failed to load';
    });
  });

  closeBtn?.addEventListener('click', close);

  dialog?.addEventListener('click', function(e) {
    if (e.target === dialog) close();
  });

  dialog?.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowLeft') prev();
    if (e.key === 'ArrowRight') next();
  });

  var touchStartX = 0;
  var touchStartY = 0;

  dialog?.addEventListener('touchstart', function(e) {
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
  }, { passive: true });

  dialog?.addEventListener('touchend', function(e) {
    var dx = e.changedTouches[0].clientX - touchStartX;
    var dy = e.changedTouches[0].clientY - touchStartY;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
      if (dx > 0) prev();
      else next();
    }
  }, { passive: true });
</script>
