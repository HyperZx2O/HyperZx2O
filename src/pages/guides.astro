---
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';

const guides = [
  {
    title: 'Translucent Win11',
    description: 'A complete guide to giving Windows 11 a glassmorphism makeover — from system-level transparency tools to app-by-app configurations, all in one place.',
    github: 'https://github.com/HyperZx2O/Translucent-Win11',
    stars: 92,
  },
  {
    title: 'Agentic Development Workflow',
    description: 'A phase-locked, prompt-driven system for AI-assisted hackathon development. Spec it, plan it, code it, review it — no more "what are we building again" at 3am.',
    github: 'https://github.com/HyperZx2O/agentic-development-workflow',
    live: 'https://hyperzx2o.github.io/agentic-development-workflow/',
    stars: 6,
  },
];

const articles = (await getCollection('articles')).sort((a, b) => b.data.date.localeCompare(a.data.date));

const coverAssets = import.meta.glob('../../articles/*/*.{jpg,jpeg,png,webp,avif}', { eager: true }) as Record<string, { default: ImageMetadata }>;
const pdfAssets = import.meta.glob('../../articles/*/*.pdf', { eager: true, query: '?url', import: 'default' }) as Record<string, string>;

const base = import.meta.env.BASE_URL;
const articleUrl = (id: string) => encodeURI(`${base}articles/${id}/`);

const monthYear = (value: string) =>
  new Date(`${value}-01T00:00:00`).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });

function excerptOf(body: string | undefined, limit = 165) {
  if (!body) return '';
  const blocks = body.split(/\n\s*\n/).map((b) => b.trim()).filter(Boolean);
  const first = blocks.find((b) => !b.startsWith('#') && !b.startsWith('![') && !b.startsWith('*'));
  const text = (first ?? '').replace(/^#+\s*/, '').replace(/[*_`]/g, '').replace(/\s+/g, ' ').trim();
  return text.length > limit ? text.slice(0, limit).replace(/\s\S*$/, '') + '…' : text;
}
---

<Layout title="Writing — HyperZx2O" description="Articles and guides by MD. Sadman Saif Zarif — published writing on ecology, AI engineering and urban health, plus practical build guides.">

  <section class="writing-hero section">
    <div class="container">
      <p class="section-tag mono-label">Writing</p>
      <h1 class="display-lg">Articles &amp; Guides</h1>
      <p class="body-lg muted">Published pieces and the guides I keep for myself.</p>
    </div>
  </section>

  <section class="writing-list" aria-labelledby="articles-label">
    <div class="container">
      <div class="writing-bar">
        <h2 class="writing-label display-md" id="articles-label">Articles</h2>
        <span class="writing-count mono-label">{articles.length} published</span>
      </div>

      <div class="article-grid-list stagger">
        {articles.map((article) => (
          <article class="writing-card writing-card--article min-w-0 card-spotlight-active">
            <div class="card-spotlight" aria-hidden="true"></div>
            <a href={articleUrl(article.id)} class="writing-thumb" tabindex="-1" aria-hidden="true">
              <Picture
                src={coverAssets[`../../articles/${article.id}/${article.data.cover}`].default}
                widths={[400, 800]}
                formats={['avif', 'webp']}
                sizes="(max-width: 768px) 100vw, 420px"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="writing-body">
              <p class="writing-meta mono-label">{article.data.publication} · {monthYear(article.data.date)}</p>
              <h3 class="writing-title heading-3">
                <a href={articleUrl(article.id)}>{article.data.title}</a>
              </h3>
              <p class="writing-desc text-clamp-3">{excerptOf(article.body)}</p>
              <ul class="article-tags">
                {article.data.tags.map((tag) => <li class="tech-tag mono-label">{tag}</li>)}
              </ul>
              <div class="writing-links">
                <a href={articleUrl(article.id)} class="writing-link mono-label">Read →</a>
                <a href={pdfAssets[`../../articles/${article.id}/${article.data.pdf}`]} download class="writing-link writing-link--alt mono-label">PDF ↓</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="writing-list" aria-labelledby="guides-label">
    <div class="container">
      <div class="writing-bar">
        <h2 class="writing-label display-md" id="guides-label">Guides</h2>
        <span class="writing-count mono-label">{guides.length} written</span>
      </div>

      <div class="guides-grid stagger">
        {guides.map(guide => (
          <article class="guide-card stack-hover min-w-0 card-spotlight-active">
            <div class="card-spotlight" aria-hidden="true"></div>
            <div class="guide-card-inner">
              <div class="guide-header">
                <h3 class="heading-2 text-truncate">{guide.title}</h3>
                <span class="guide-stars mono-label">⭐ {guide.stars}</span>
              </div>
              <p class="guide-desc">{guide.description}</p>
              <div class="guide-links">
                <a href={guide.github} target="_blank" rel="noopener" class="guide-link mono-label">GitHub →</a>
                {guide.live && (
                  <a href={guide.live} target="_blank" rel="noopener" class="guide-link mono-label">Live Site →</a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>

      <p class="guides-extensible mono-label">More when I find something worth sharing.</p>
    </div>
  </section>

</Layout>

<style>
  .writing-hero .display-lg {
    margin-bottom: var(--space-lg);
  }

  .writing-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-lg);
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }
  .writing-label {
    margin: 0;
  }
  .writing-count {
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .writing-list + .writing-list {
    margin-top: var(--space-4xl);
  }

  .article-grid-list {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 900px) {
    .article-grid-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .writing-card {
    border: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }
  .writing-card:hover {
    border-color: var(--color-accent);
  }
  .writing-card:focus-within {
    border-color: var(--color-accent);
  }
  .writing-card > * {
    position: relative;
    z-index: 1;
  }

  .writing-thumb {
    display: block;
    border-bottom: 1px solid var(--color-border-subtle);
    overflow: hidden;
  }
  .writing-thumb :global(img) {
    width: 100%;
    height: 190px;
    object-fit: cover;
    display: block;
    filter: saturate(0.85);
    transition: filter var(--transition-smooth), transform var(--transition-smooth);
  }
  .writing-card:hover .writing-thumb :global(img) {
    filter: saturate(1);
    transform: scale(1.03);
  }

  .writing-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-xl);
    flex: 1;
  }
  .writing-meta {
    color: var(--color-accent);
  }
  .writing-title {
    margin: 0;
  }
  .writing-title a:hover {
    color: var(--color-accent);
  }
  .writing-desc {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.65;
    flex: 1;
  }
  .writing-links {
    display: flex;
    gap: var(--space-xl);
    margin-top: var(--space-sm);
  }
  .writing-link {
    color: var(--color-accent);
    font-size: var(--text-xs);
  }
  .writing-link--alt {
    color: var(--color-text-muted);
  }
  .writing-link--alt:hover {
    color: var(--color-accent);
  }

  /* Guides (carried over from the original guides page) */
  .guides-grid {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 768px) {
    .guides-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .guide-card {
    border: 1px solid var(--color-border-subtle);
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    perspective: 800px;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: border-color var(--transition-instant), transform var(--transition-fast);
  }
  .guide-card:hover {
    border-color: var(--color-accent);
  }
  .guide-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .guide-card > * {
    position: relative;
    z-index: 1;
  }
  .guide-card-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    height: 100%;
  }
  .guide-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-md);
  }
  .guide-stars {
    color: var(--color-accent);
    font-size: var(--text-sm);
    flex-shrink: 0;
  }
  .guide-desc {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.7;
    flex: 1;
  }
  .guide-links {
    display: flex;
    gap: var(--space-xl);
    margin-top: auto;
  }
  .guide-link {
    color: var(--color-accent);
    font-size: var(--text-xs);
  }

  .guides-extensible {
    margin-top: var(--space-3xl);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  @media (prefers-reduced-motion: reduce) {
    .guide-card {
      transition: border-color var(--transition-instant) !important;
      transform: none !important;
    }
  }
</style>

<script>
  const cards = document.querySelectorAll('.guide-card');
  cards.forEach(card => {
    card.addEventListener('mousemove', (e: Event) => (window as any).applyTilt(e as MouseEvent));
    card.addEventListener('mouseleave', (e: Event) => (window as any).resetTilt(e as MouseEvent));
    card.addEventListener('touchstart', (e: Event) => (window as any).resetTilt(e as MouseEvent));
  });
</script>
