    .devcard::before { animation: none !important; }
  }
</style>

<script>
  // Accordion
  document.querySelectorAll('.t-acc-head').forEach(head => {
    head.addEventListener('click', () => {
      const acc = head.closest('.t-acc')!;
      const open = acc.getAttribute('data-open') === 'true';
      acc.setAttribute('data-open', String(!open));
      head.setAttribute('aria-expanded', String(!open));
    });
    head.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const acc = head.closest('.t-acc')!;
        acc.setAttribute('data-open', 'false');
        head.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // Confetti burst + email copy + redirect
  const confettiBtn = document.querySelector('.confetti-btn') as HTMLElement;
  const toast = document.querySelector('.t-toast') as HTMLElement;
  let toastTimer: ReturnType<typeof setTimeout>;

  confettiBtn?.addEventListener('click', function(this: HTMLElement) {
    const anchor = this.closest('.confetti-anchor')!;
    const cs = getComputedStyle(document.documentElement);
    const colors = [
      cs.getPropertyValue('--color-accent').trim(),
      cs.getPropertyValue('--color-surface').trim(),
      cs.getPropertyValue('--color-primary').trim(),
      cs.getPropertyValue('--color-text').trim(),
    ];
    
    // Copy email to clipboard
    navigator.clipboard.writeText('sadman.zarifsaif@gmail.com').catch(() => {});
    
    // Haptic on commit (mobile only; safe no-op on desktop)
    navigator.vibrate?.(10);
    
    // Show toast
    clearTimeout(toastTimer);
    toast?.classList.add('is-open');
    toastTimer = setTimeout(() => toast?.classList.remove('is-open'), 2000);
    
    // Redirect to email client
    window.location.href = 'mailto:sadman.zarifsaif@gmail.com';
    
    // Show confetti
    for (let i = 0; i < 20; i++) {
      const piece = document.createElement('span');
      piece.className = 't-confetti-piece';
      piece.style.background = colors[i % colors.length];
      piece.style.setProperty('--cx', `${(Math.random() - 0.5) * 120}px`);
      piece.style.setProperty('--cy', `${-30 - Math.random() * 60}px`);
      piece.style.setProperty('--cr', `${Math.random() * 360}deg`);
      anchor.appendChild(piece);
      piece.addEventListener('animationend', () => piece.remove());
    }
  });

  // Image dialog
  const imgDialog = document.querySelector('.img-dialog') as HTMLDialogElement;
  const imgDialogImg = document.querySelector('.img-dialog-img') as HTMLImageElement;
  const imgDialogClose = document.querySelector('.img-dialog-close');
  document.querySelectorAll('.img-link').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const href = (link as HTMLAnchorElement).href;
      imgDialogImg.src = href;
      imgDialogImg.alt = (link.querySelector('img') as HTMLImageElement)?.alt || '';
      imgDialog.showModal();
      (window as any).__lockScroll?.();
    });
  });
  imgDialogClose?.addEventListener('click', () => imgDialog.close());
  imgDialog?.addEventListener('click', (e) => {
    if (e.target === imgDialog) imgDialog.close();
  });
  // Unlock scroll on ANY close path (button, backdrop click, Escape, programmatic)
  imgDialog?.addEventListener('close', () => (window as any).__unlockScroll?.());
</script>
