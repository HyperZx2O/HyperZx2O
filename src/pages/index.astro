---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="HyperZx2O — Portfolio">

  <!-- Hero -->
  <section class="hero">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="hero-shapes" aria-hidden="true">
      <span class="hero-shape hero-shape--1"></span>
      <span class="hero-shape hero-shape--2"></span>
      <span class="hero-shape hero-shape--3"></span>
      <span class="hero-shape hero-shape--4"></span>
      <span class="hero-shape hero-shape--5"></span>
      <span class="hero-tri hero-tri--a"></span>
      <span class="hero-tri hero-tri--b"></span>
      <span class="hero-tri hero-tri--c"></span>
      <span class="hero-tri hero-tri--d"></span>
      <span class="hero-tri hero-tri--e"></span>
      <span class="hero-tri hero-tri--f"></span>
      <span class="hero-tri hero-tri--g"></span>
      <span class="hero-tri hero-tri--h"></span>
      <span class="hero-blob hero-blob--1"></span>
      <span class="hero-blob hero-blob--2"></span>
      <span class="hero-blob hero-blob--3"></span>
      <span class="hero-blob hero-blob--4"></span>
      <span class="hero-blob hero-blob--5"></span>
    </div>
    <div class="container hero-inner">
        <div class="hero-text">
          <p class="hero-tag mono-label reveal">[ MD. Sadman Saif Zarif ]</p>
          <h1 class="hero-name display-hero shimmer">Serial<br/>hackathon<br/>survivor.</h1>
          <p class="hero-subtitle body-lg reveal">
            CSE @ IUT · Web Dev · Competitive Programming
          </p>

          <div class="hero-about">
          <p class="hero-intro">
            I'm a CSE student at IUT, Bangladesh. I build things across hackathons, coursework, solo experiments and I have a bad habit of shipping more than the brief asked for. The through-line is software that actually fits where it's used, not just software that works.
          </p>
          <div class="t-acc" data-open="false">
            <button class="t-acc-head hero-expand-toggle mono-label" aria-expanded="false">
              More about me
              <span class="t-acc-chevron">
                <svg viewBox="0 0 16 16"><path d="M4 6.5L8 10.5L12 6.5"/></svg>
              </span>
            </button>
            <div class="t-acc-panel">
              <div class="t-acc-panel-inner">
                <div class="hero-expanded">
                  <p>I grew up just messing around with computers. Games, random corners of the internet, taking things apart to see what happened. Nobody framed it as a career. It just quietly became one.</p>
                  <p>I'm a CSE student at IUT now. My first real project was Barakah Bites — a cafeteria ordering system we built at DevSprint 2026, during Ramadan of all times. Five Dockerized microservices, real-time order tracking, a kitchen queue, the whole thing. We built it inside a hackathon window. That was the first time something I made felt like it actually belonged to me.</p>
                  <p>Hackathons are where something clicks for me. The pressure, the pace, everyone scrambling toward the same deadline.</p>
                  <p>I haven't decided where I'm going yet. Web dev and AI/ML are both pulling at me and I'm not going to pretend I've figured it out. What I do know is I'd rather ship something real than spend too long deciding what to build.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="featured section reveal">
    <div class="container">
      <p class="section-tag mono-label">Featured Work</p>
      <h2 class="display-md">My Favorites</h2>

      <div class="featured-grid stagger">
        <!-- ContextForge -->
        <article class="featured-card featured-card--wide t-border-beam-on min-w-0 card-spotlight-active">
          <div class="t-border-beam"></div>
          <div class="card-spotlight" aria-hidden="true"></div>
          <figure class="featured-preview">
            <a href={`${base}contextforge.jpg`} class="img-link" aria-label="View full image">
              <img src={`${base}contextforge.jpg`} alt="ContextForge knowledge graph interface" width="800" height="450" loading="lazy" decoding="async" />
            </a>
          </figure>
          <div class="featured-body-wrap">
            <span class="featured-label mono-label">RESEARCH TOOL</span>
            <h3 class="heading-2">ContextForge</h3>
            <p class="featured-tagline">See the shape of the research frontier.</p>
            <p class="featured-body">
              A research intelligence platform that ingests papers, code repos, and news, then constructs a typed knowledge graph — surfacing contradictions, research gaps, and extensions that traditional lit reviews miss.
            </p>
            <div class="featured-pipeline">
              <span>Ingest</span>
              <span class="featured-pipe-arrow">→</span>
              <span>Extract</span>
              <span class="featured-pipe-arrow">→</span>
              <span>Synthesize</span>
              <span class="featured-pipe-arrow">→</span>
              <span>Find Gaps</span>
            </div>
            <div class="featured-tech">
              <span class="tech-tag mono-label">Python</span>
              <span class="tech-tag mono-label">FastAPI</span>
              <span class="tech-tag mono-label">Neo4j</span>
              <span class="tech-tag mono-label">React</span>
              <span class="tech-tag mono-label">SciSpaCy</span>
              <span class="tech-tag mono-label">Docker</span>
            </div>
            <div class="featured-links">
              <a href="https://github.com/HyperZx2O/contextforge" target="_blank" rel="noopener" class="featured-link mono-label">GitHub →</a>
              <a href="https://contextforge-chi.vercel.app" target="_blank" rel="noopener" class="featured-link mono-label">Live Demo →</a>
            </div>
          </div>
        </article>

        <!-- Translucent Win11 -->
        <article class="featured-card featured-card--compact t-border-beam-on min-w-0 card-spotlight-active">
          <div class="t-border-beam"></div>
          <div class="card-spotlight" aria-hidden="true"></div>
          <figure class="featured-preview">
            <a href={`${base}win11guide.png`} class="img-link" aria-label="View full image">
              <img src={`${base}win11guide.png`} alt="Translucent Win11 glassmorphism desktop" width="800" height="450" loading="lazy" decoding="async" />
            </a>
          </figure>
          <div class="featured-body-wrap">
            <span class="featured-label mono-label">COMMUNITY GUIDE</span>
            <h3 class="heading-2">Translucent Win11</h3>
            <p class="featured-tagline">A complete guide to giving Windows 11 a glassmorphism makeover.</p>
            <div class="featured-stat-big">
              <span class="featured-stat-num">92</span>
              <span class="featured-stat-label mono-label">Stars on GitHub</span>
            </div>
            <ul class="featured-covers">
              <li>System theming + transparency</li>
              <li>App replacements & alternatives</li>
              <li>Tiling window manager setup</li>
              <li>Browser + Spotify customization</li>
            </ul>
            <div class="featured-links">
              <a href="https://github.com/HyperZx2O/Translucent-Win11" target="_blank" rel="noopener" class="featured-link mono-label">GitHub →</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Competitive Programming -->
  <section class="cp section reveal">
    <div class="container">
      <div class="cp-grid">
        <div class="cp-float-wrap">
          <figure class="cp-card card-spotlight-active">
            <div class="cp-card-inner">
              <img src={`${base}profileCard.png`} alt="Codeforces profile" width="600" height="400" loading="lazy" decoding="async" />
              <svg class="cp-card-grain" aria-hidden="true"><filter id="cp-noise"><feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(#cp-noise)"/></svg>
            </div>
          </figure>
        </div>
        <div class="cp-text">
          <p class="section-tag mono-label">Competitive Programming</p>
          <p class="cp-body">I was never really into competitive programming. Then my Structured Programming professor dropped a Codeforces contest with 150 problems as a quiz. I got through 65 plus of them. Don't do much anymore, but that pressure is exactly what I chase during hackathons now.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats section reveal">
    <div class="container">
      <div class="stats-grid">
        <div class="stats-col stagger">
          <div class="stat-card">
            <span class="stat-number display-md">10</span>
            <span class="stat-label mono-label">Projects</span>
          </div>
          <div class="stat-card">
            <span class="stat-number display-md">6</span>
            <span class="stat-label mono-label">Hackathons</span>
          </div>
          <div class="stat-card">
            <span class="stat-number display-md">140+</span>
            <span class="stat-label mono-label">Stars Earned</span>
          </div>
        </div>
        <div class="devcard-float-wrap">
          <figure class="stats-devcard devcard card-spotlight-active">
            <div class="devcard-inner">
              <img src={`${base}devCard.png`} alt="GitHub stats" width="495" height="195" loading="lazy" decoding="async" />
              <svg class="devcard-grain" aria-hidden="true"><filter id="dc-noise"><feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(#dc-noise)"/></svg>
            </div>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="timeline section reveal">
    <div class="container">
      <p class="section-tag mono-label">Journey</p>
      <h2 class="display-md">Where I've been.</h2>
      <div class="timeline-track stagger">
        <div class="timeline-line" aria-hidden="true"></div>
        <div class="timeline-node">
          <span class="timeline-dot" aria-hidden="true"></span>
          <div class="timeline-content">
            <span class="timeline-year mono-label">2022</span>
            <h3 class="timeline-title">St. Gregory's High School & College</h3>
            <p class="timeline-note">Where it started.</p>
          </div>
        </div>
        <div class="timeline-node">
          <span class="timeline-dot" aria-hidden="true"></span>
          <div class="timeline-content">
            <span class="timeline-year mono-label">2024</span>
            <h3 class="timeline-title">Notre Dame College</h3>
            <p class="timeline-note">Where things clicked.</p>
          </div>
        </div>
        <div class="timeline-node">
          <span class="timeline-dot" aria-hidden="true"></span>
          <div class="timeline-content">
            <span class="timeline-year mono-label">Ongoing</span>
            <h3 class="timeline-title">Islamic University of Technology</h3>
            <p class="timeline-note">CSE. Building things that ship.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo Strip -->
  <section class="photostrip section reveal">
    <div class="photostrip-scroll">
      <img src={`${base}gallery/DSC_5278.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
      <img src={`${base}gallery/DSC_5266.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
      <img src={`${base}gallery/DSC_5152.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
      <img src={`${base}gallery/DSC_5071.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
      <img src={`${base}gallery/DSC_4980.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
      <img src={`${base}gallery/DSC_4915.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
      <img src={`${base}gallery/DSC_4894.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
      <img src={`${base}gallery/DSC_4888.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
      <img src={`${base}gallery/DSC_4887.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
      <img src={`${base}gallery/DSC_4823.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
      <img src={`${base}gallery/DSC_4796.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
      <img src={`${base}gallery/DSC_4786.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
      <img src={`${base}gallery/IMG_20250923_114929.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
      <img src={`${base}gallery/IMG_20250813_091240.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
      <img src={`${base}gallery/20260322_182940.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
      <img src={`${base}gallery/20260119_161651.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
      <img src={`${base}gallery/1766558246484.jpg`} alt="" width="400" height="300" loading="lazy" decoding="async" />
    </div>
    <svg class="photostrip-noise" aria-hidden="true"><filter id="ps-noise"><feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(#ps-noise)" opacity="0.08"/></svg>
  </section>

<!-- Contact -->
  <section class="contact section reveal">
    <div class="contact-shapes" aria-hidden="true">
      <span class="contact-tri contact-tri--a"></span>
      <span class="contact-tri contact-tri--b"></span>
      <span class="contact-tri contact-tri--c"></span>
      <span class="contact-tri contact-tri--d"></span>
      <span class="contact-tri contact-tri--e"></span>
      <span class="contact-tri contact-tri--f"></span>
      <span class="contact-tri contact-tri--g"></span>
      <span class="contact-tri contact-tri--h"></span>
      <span class="contact-blob contact-blob--1"></span>
      <span class="contact-blob contact-blob--2"></span>
      <span class="contact-blob contact-blob--3"></span>
      <span class="contact-blob contact-blob--4"></span>
      <span class="contact-blob contact-blob--5"></span>
    </div>
    <div class="container">
      <p class="section-tag mono-label">Contact</p>
      <h2 class="contact-heading display-hero shimmer">Let's build something.</h2>
      <div class="confetti-anchor">
        <button type="button" class="cta-button mono-label confetti-btn">Say Hello →</button>
      </div>
    </div>
  </section>

  <div class="t-toast" aria-live="polite">Email copied!</div>

  <dialog class="img-dialog" aria-label="Full image view">
    <button class="img-dialog-close" aria-label="Close">&times;</button>
    <figure class="img-dialog-figure">
      <img class="img-dialog-img" src="" alt="" />
    </figure>
  </dialog>

  <script is:inline>
    // Cursor‑reactive tilt + spotlight for featured cards
    const tiltCards = document.querySelectorAll('.featured-card, .cp-card, .devcard');
    tiltCards.forEach(card => {
      card.addEventListener('mousemove', (e) => (window as any).applyTilt(e));
      card.addEventListener('mouseleave', (e) => (window as any).resetTilt(e));
      card.addEventListener('touchstart', (e) => (window as any).resetTilt(e));
    });
  </script>

</Layout>

<style>
  /* Hero */
  .hero {
    padding-top: calc(56px + var(--space-4xl));
    padding-bottom: var(--space-4xl);
    min-height: 100dvh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 40%, black 20%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 70% 40%, black 20%, transparent 70%);
  }
  .hero-shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-shape {
    position: absolute;
    border-radius: 2px;
    opacity: 0;
    animation: shape-float 20s ease-in-out infinite, shape-fade-in 1s ease forwards;
    filter: blur(0.5px);
  }
  .hero-shape--1 {
    width: 100px; height: 100px;
    top: 15%; right: 10%;
    border: 2px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.15);
    animation-delay: 0s, 0.3s;
    transform: rotate(15deg);
  }
  .hero-shape--2 {
    width: 50px; height: 50px;
    top: 32%; right: 26%;
    background: rgba(255, 255, 255, 0.35);
    box-shadow: 0 0 24px rgba(255, 255, 255, 0.2);
    animation-delay: -4s, 0.5s;
    border-radius: 50%;
  }
  .hero-shape--3 {
    width: 160px; height: 2px;
    top: 52%; right: 6%;
    background: rgba(255, 255, 255, 0.4);
    box-shadow: 0 0 16px rgba(255, 255, 255, 0.2);
    animation-delay: -8s, 0.7s;
  }
  .hero-shape--4 {
    width: 60px; height: 60px;
    bottom: 18%; right: 20%;
    border: 2px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.15);
    animation-delay: -12s, 0.9s;
    border-radius: 50%;
  }
  .hero-shape--5 {
    width: 35px; height: 35px;
    top: 22%; right: 38%;
    background: rgba(255, 255, 255, 0.25);
    box-shadow: 0 0 18px rgba(255, 255, 255, 0.15);
    animation-delay: -6s, 1.1s;
    transform: rotate(45deg);
  }
  @keyframes shape-float {
    0%, 100% { transform: translateY(0) rotate(var(--rot, 0deg)); }
    33% { transform: translateY(-12px) rotate(calc(var(--rot, 0deg) + 3deg)); }
    66% { transform: translateY(8px) rotate(calc(var(--rot, 0deg) - 2deg)); }
  }
  @keyframes shape-fade-in {
    to { opacity: var(--target-opacity, 0.12); }
  }
  .hero-shape--1 { --rot: 15deg; --target-opacity: 0.5; }
  .hero-shape--2 { --rot: 0deg; --target-opacity: 0.35; }
  .hero-shape--3 { --rot: 0deg; --target-opacity: 0.4; }
  .hero-shape--4 { --rot: 0deg; --target-opacity: 0.4; }
  .hero-shape--5 { --rot: 45deg; --target-opacity: 0.25; }

  /* Triangles — clip-path shapes, scattered across hero */
  .hero-tri {
    position: absolute;
    clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
    opacity: 0;
    will-change: transform, opacity;
  }
  .hero-tri--a {
    width: 180px; height: 180px;
    background: rgba(255,255,255,0.06);
    filter: blur(3px);
    top: 5%; left: 6%;
    --tri-dur: 22s; --tri-xy: 30px 20px; --tri-rot: 12deg;
  }
  .hero-tri--b {
    width: 120px; height: 120px;
    background: rgba(255,255,255,0.1);
    filter: blur(2px);
    top: 60%; right: 8%;
    --tri-dur: 18s; --tri-xy: -24px -18px; --tri-rot: -30deg;
  }
  .hero-tri--c {
    width: 70px; height: 70px;
    background: rgba(255,255,255,0.18);
    filter: blur(1px);
    top: 18%; right: 18%;
    --tri-dur: 14s; --tri-xy: 16px -22px; --tri-rot: 45deg;
  }
  .hero-tri--d {
    width: 95px; height: 95px;
    background: rgba(255,255,255,0.12);
    filter: blur(1.5px);
    bottom: 20%; left: 18%;
    --tri-dur: 20s; --tri-xy: -20px 16px; --tri-rot: -15deg;
  }
  .hero-tri--e {
    width: 40px; height: 40px;
    background: rgba(255,255,255,0.3);
    top: 35%; right: 30%;
    --tri-dur: 12s; --tri-xy: 12px -14px; --tri-rot: 60deg;
  }
  .hero-tri--f {
    width: 55px; height: 55px;
    background: rgba(255,255,255,0.2);
    bottom: 30%; right: 12%;
    --tri-dur: 16s; --tri-xy: -18px 12px; --tri-rot: 25deg;
  }
  .hero-tri--g {
    width: 140px; height: 140px;
    background: rgba(255,255,255,0.07);
    filter: blur(2.5px);
    top: 45%; left: 3%;
    --tri-dur: 26s; --tri-xy: 22px -16px; --tri-rot: -40deg;
  }
  .hero-tri--h {
    width: 35px; height: 35px;
    background: rgba(255,255,255,0.25);
    top: 12%; right: 40%;
    --tri-dur: 10s; --tri-xy: -10px 18px; --tri-rot: 80deg;
  }
  .hero-tri--a { animation: tri-a 22s ease-in-out infinite, tri-fade 1s ease 0.4s forwards; }
  .hero-tri--b { animation: tri-b 18s ease-in-out infinite, tri-fade 1s ease 0.6s forwards; }
  .hero-tri--c { animation: tri-c 14s ease-in-out infinite, tri-fade 1s ease 0.8s forwards; }
  .hero-tri--d { animation: tri-d 20s ease-in-out infinite, tri-fade 1s ease 1.0s forwards; }
  .hero-tri--e { animation: tri-e 12s ease-in-out infinite, tri-fade 1s ease 0.5s forwards; }
  .hero-tri--f { animation: tri-f 16s ease-in-out infinite, tri-fade 1s ease 0.7s forwards; }
  .hero-tri--g { animation: tri-g 26s ease-in-out infinite, tri-fade 1s ease 0.9s forwards; }
  .hero-tri--h { animation: tri-h 10s ease-in-out infinite, tri-fade 1s ease 1.1s forwards; }

  @keyframes tri-fade { to { opacity: 1; } }
  @keyframes tri-a {
    0%,100% { transform: translate(0,0) rotate(12deg); }
    25% { transform: translate(24px,-16px) rotate(18deg); }
    50% { transform: translate(-8px,20px) rotate(8deg); }
    75% { transform: translate(16px,8px) rotate(15deg); }
  }
  @keyframes tri-b {
    0%,100% { transform: translate(0,0) rotate(-30deg); }
    33% { transform: translate(-20px,14px) rotate(-22deg); }
    66% { transform: translate(12px,-18px) rotate(-35deg); }
  }
  @keyframes tri-c {
    0%,100% { transform: translate(0,0) rotate(45deg); }
    50% { transform: translate(18px,-20px) rotate(55deg); }
  }
  @keyframes tri-d {
    0%,100% { transform: translate(0,0) rotate(-15deg); }
    25% { transform: translate(-14px,-10px) rotate(-8deg); }
    75% { transform: translate(10px,16px) rotate(-20deg); }
  }
  @keyframes tri-e {
    0%,100% { transform: translate(0,0) rotate(60deg); }
    33% { transform: translate(10px,12px) rotate(70deg); }
    66% { transform: translate(-8px,-10px) rotate(55deg); }
  }
  @keyframes tri-f {
    0%,100% { transform: translate(0,0) rotate(25deg); }
    50% { transform: translate(-16px,10px) rotate(32deg); }
  }
  @keyframes tri-g {
    0%,100% { transform: translate(0,0) rotate(-40deg); }
    33% { transform: translate(18px,-12px) rotate(-32deg); }
    66% { transform: translate(-10px,14px) rotate(-45deg); }
  }
  @keyframes tri-h {
    0%,100% { transform: translate(0,0) rotate(80deg); }
    50% { transform: translate(-12px,-14px) rotate(90deg); }
  }

  /* Gradient blobs — soft atmospheric glow, drift actively */
  .hero-blob {
    position: absolute;
    border-radius: 50%;
    opacity: 0;
    will-change: transform, opacity;
  }
  .hero-blob--1 {
    width: 350px; height: 350px;
    top: 8%; right: 3%;
    background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
    filter: blur(60px);
    animation: blob-1 20s ease-in-out infinite, blob-fade 1.2s ease 0.6s forwards;
  }
  .hero-blob--2 {
    width: 280px; height: 280px;
    bottom: 8%; right: 22%;
    background: radial-gradient(circle, rgba(255,255,255,0.09) 0%, transparent 70%);
    filter: blur(50px);
    animation: blob-2 24s ease-in-out infinite, blob-fade 1.2s ease 0.8s forwards;
  }
  .hero-blob--3 {
    width: 200px; height: 200px;
    top: 50%; left: 10%;
    background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
    filter: blur(45px);
    animation: blob-3 18s ease-in-out infinite, blob-fade 1.2s ease 1.0s forwards;
  }
  .hero-blob--4 {
    width: 160px; height: 160px;
    top: 15%; left: 35%;
    background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
    filter: blur(40px);
    animation: blob-4 22s ease-in-out infinite, blob-fade 1.2s ease 1.2s forwards;
  }
  .hero-blob--5 {
    width: 240px; height: 240px;
    bottom: 2%; left: 30%;
    background: radial-gradient(circle, rgba(255,255,255,0.07) 0%, transparent 70%);
    filter: blur(55px);
    animation: blob-5 26s ease-in-out infinite, blob-fade 1.2s ease 0.5s forwards;
  }
  @keyframes blob-fade { to { opacity: 1; } }
  @keyframes blob-1 {
    0%,100% { transform: translate(0,0) scale(1); }
    25% { transform: translate(-28px,18px) scale(1.05); }
    50% { transform: translate(14px,-22px) scale(0.95); }
    75% { transform: translate(-10px,-8px) scale(1.02); }
  }
  @keyframes blob-2 {
    0%,100% { transform: translate(0,0) scale(1); }
    33% { transform: translate(20px,-14px) scale(1.06); }
    66% { transform: translate(-16px,20px) scale(0.94); }
  }
  @keyframes blob-3 {
    0%,100% { transform: translate(0,0) scale(1); }
    25% { transform: translate(18px,12px) scale(1.04); }
    50% { transform: translate(-22px,-10px) scale(0.96); }
    75% { transform: translate(10px,-18px) scale(1.02); }
  }
  @keyframes blob-4 {
    0%,100% { transform: translate(0,0) scale(1); }
    50% { transform: translate(-16px,14px) scale(1.03); }
  }
  @keyframes blob-5 {
    0%,100% { transform: translate(0,0) scale(1); }
    33% { transform: translate(14px,-18px) scale(1.05); }
    66% { transform: translate(-20px,10px) scale(0.97); }
  }

  .hero-inner {
    display: flex;
    align-items: center;
    width: 100%;
  }
  .hero-text {
  }
  .hero-tag {
    color: var(--color-accent);
    margin-bottom: var(--space-lg);
  }
  .hero-name {
    color: var(--color-text);
    margin-bottom: var(--space-xl);
  }
  .hero-subtitle {
    color: var(--color-text-muted);
    margin-bottom: var(--space-3xl);
  }

  .hero-about {
    max-width: 60ch;
    margin-bottom: var(--space-3xl);
  }
  .hero-intro {
    font-size: 1.125rem;
    line-height: 1.65;
    margin-bottom: var(--space-lg);
  }

  .hero-expand-toggle {
    cursor: pointer;
    color: var(--color-accent);
    font-size: var(--text-xs);
    list-style: none;
    transition: opacity var(--transition-instant);
  }
  .hero-expand-toggle:hover {
    opacity: 0.8;
  }
  .hero-expand-toggle::-webkit-details-marker {
    display: none;
  }
  .hero-expanded {
    padding-top: var(--space-lg);
    color: var(--color-text-muted);
    line-height: 1.7;
  }
  .hero-expanded p {
    max-width: 60ch;
  }

  .section .display-md {
    margin-bottom: var(--space-3xl);
    max-width: 20ch;
  }

  /* Featured — Bento Grid */
  .featured-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }
  @media (min-width: 768px) {
    .featured-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-xl);
      align-items: stretch;
    }
  }

  .featured-card {
    border: 1px solid var(--color-border-subtle);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    contain: layout style paint;
    perspective: 800px;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: border-color var(--transition-instant), transform var(--transition-fast);
    position: relative;
    overflow: hidden;
  }
  .featured-card:hover {
    border-color: var(--color-accent);
  }
  .featured-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .featured-body-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    position: relative;
    z-index: 1;
  }

  /* Wide card — horizontal on desktop (bento: tall left) */
  .featured-card--wide {
    background: linear-gradient(135deg, rgba(255,255,255,0.02) 0%, transparent 60%);
  }
  @media (min-width: 768px) {
    .featured-card--wide {
      grid-row: span 1;
    }
    .featured-card--wide .featured-preview img {
      min-height: 320px;
    }
  }

  /* Compact card (bento: right column) */
  .featured-card--compact {
    background: linear-gradient(225deg, rgba(255,255,255,0.02) 0%, transparent 60%);
  }

  /* Featured preview image */
  .featured-preview {
    margin: calc(-1 * var(--space-xl)) calc(-1 * var(--space-xl)) 0;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border-subtle);
    position: relative;
  }
  .featured-preview img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    transition: transform 200ms var(--ease-out);
    filter: saturate(0.85);
  }
  .featured-card:hover .featured-preview img {
    transform: scale(1.03);
    filter: saturate(1);
  }

  .featured-label {
    color: var(--color-accent);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
  }

  .featured-tagline {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.5;
  }

  .featured-body {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  /* Pipeline strip */
  .featured-pipeline {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }
  .featured-pipeline span:first-child { color: var(--color-text); }
  .featured-pipeline span:nth-child(3) { color: var(--color-text); }
  .featured-pipeline span:nth-child(5) { color: var(--color-text); }
  .featured-pipeline span:last-child { color: var(--color-text); }
  .featured-pipe-arrow {
    color: var(--color-accent);
  }

  /* Big stat callout */
  .featured-stat-big {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-lg);
    border: 1px solid var(--color-border-subtle);
    text-align: center;
  }
  .featured-stat-num {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }
  .featured-stat-label {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .featured-pipe-arrow {
    color: var(--color-accent);
  }

  /* Covers list */
  .featured-covers {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }
  .featured-covers li::before {
    content: '—';
    color: var(--color-accent);
    margin-right: var(--space-sm);
  }

  .featured-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .featured-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-top: auto;
  }
  .featured-link {
    color: var(--color-accent);
    font-size: var(--text-xs);
  }

  /* Image link + dialog */
  .img-link {
    display: block;
    cursor: zoom-in;
  }
  .img-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: rgba(0, 0, 242, 0.92);
    color: var(--color-text);
    z-index: 200;
    opacity: 0;
    transition: opacity 200ms var(--ease-out);
  }
  .img-dialog[open] {
    opacity: 1;
  }
  .img-dialog::backdrop {
    background: rgba(6, 6, 28, 0.6);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  .img-dialog-figure {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: var(--space-3xl) var(--space-4xl);
  }
  .img-dialog-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 2px;
    opacity: 0;
    transform: scale(0.95);
    transition: opacity 250ms var(--ease-out), transform 250ms var(--ease-out);
  }
  .img-dialog[open] .img-dialog-img {
    opacity: 1;
    transform: scale(1);
  }
  .img-dialog-close {
    position: fixed;
    top: var(--space-lg);
    right: var(--space-lg);
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 1.5rem;
    cursor: pointer;
    z-index: 201;
    padding: var(--space-md);
    line-height: 1;
    transition: color var(--transition-instant);
  }
  .img-dialog-close:hover,
  .img-dialog-close:focus-visible {
    color: var(--color-text);
  }
  .img-dialog-close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Competitive Programming */
  .cp-grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }
  @media (min-width: 768px) {
    .cp-grid {
      grid-template-columns: 1fr 4fr;
      gap: var(--space-3xl);
    }
  }
  .cp-card {
    margin: 0;
    border: none;
    overflow: visible;
    position: relative;
    padding: 2px;
    background: conic-gradient(from var(--cp-border-angle, 0deg), transparent 60%, var(--color-accent) 80%, transparent 100%);
    animation: cp-border-spin 4s linear infinite;
    perspective: 600px;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: transform var(--transition-fast);
  }
  .cp-float-wrap {
    animation: cp-float 6s var(--ease-in-out) infinite;
    width: 100%;
  }
  .cp-card::before {
    content: '';
    position: absolute;
    inset: -20px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(237, 255, 69, 0.08) 0%, transparent 70%);
    filter: blur(20px);
    z-index: -1;
    animation: cp-pulse 4s ease-in-out infinite alternate;
  }
  .cp-card-inner {
    display: block;
    overflow: hidden;
    background: var(--color-bg);
    position: relative;
    max-width: 300px;
  }
  .cp-card img {
    width: 100%;
    height: auto;
    display: block;
    filter: saturate(0.9);
    transition: filter 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .cp-card:hover img {
    filter: saturate(1);
    transform: scale(1.05);
  }
  /* Grain overlay on image */
  .cp-card-grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.06;
    mix-blend-mode: overlay;
  }

  @keyframes cp-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  @keyframes cp-border-spin {
    to { --cp-border-angle: 360deg; }
  }
  @property --cp-border-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  @keyframes cp-pulse {
    0% { opacity: 0.5; transform: scale(1); }
    100% { opacity: 1; transform: scale(1.05); }
  }
  .cp-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .cp-body {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  /* Stats */
  .stats-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    align-items: center;
  }
  @media (min-width: 768px) {
    .stats-grid {
      flex-direction: row;
      gap: var(--space-3xl);
    }
  }
  .stats-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    flex: 1;
    justify-content: center;
  }
  @media (min-width: 768px) {
    .stats-col {
      gap: var(--space-xl);
    }
  }
  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-2xl) var(--space-lg);
    border: 1px solid var(--color-border-subtle);
    text-align: center;
  }
  .stat-number {
    color: var(--color-accent);
    line-height: 1;
  }
  .stat-label {
    color: var(--color-text-muted);
  }
  .stats-devcard {
    margin: 0;
    flex: 0 0 auto;
  }
  .devcard-float-wrap {
    animation: cp-float 7s var(--ease-in-out) infinite;
    max-width: 260px;
  }
  .devcard {
    margin: 0;
    border: none;
    overflow: visible;
    position: relative;
    padding: 2px;
    background: conic-gradient(from var(--dc-border-angle, 0deg), transparent 60%, var(--color-accent) 80%, transparent 100%);
    animation: dc-border-spin 5s linear infinite;
    perspective: 600px;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: transform var(--transition-fast);
  }
  .devcard::before {
    content: '';
    position: absolute;
    inset: -20px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(237, 255, 69, 0.08) 0%, transparent 70%);
    filter: blur(20px);
    z-index: -1;
    animation: cp-pulse 5s ease-in-out infinite alternate;
  }
  .devcard-inner {
    display: block;
    overflow: hidden;
    background: var(--color-bg);
    position: relative;
    max-width: 300px;
  }
  .stats-devcard img,
  .devcard img {
    width: 100%;
    max-width: 495px;
    height: auto;
    display: block;
    filter: saturate(0.9);
    transition: filter 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .devcard:hover img {
    filter: saturate(1);
    transform: scale(1.05);
  }
  .devcard-grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.06;
    mix-blend-mode: overlay;
  }
  @keyframes dc-border-spin {
    to { --dc-border-angle: 360deg; }
  }
  @property --dc-border-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  /* Timeline */
  .timeline {
    position: relative;
  }
  .timeline .display-md {
    margin-bottom: var(--space-3xl);
    max-width: 20ch;
  }
  .timeline-track {
    position: relative;
    padding-left: 32px;
  }
  .timeline-line {
    position: absolute;
    left: 7px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, var(--color-accent), var(--color-border-subtle) 60%, transparent);
    opacity: 1 !important;
    animation: none !important;
  }
  .timeline-node {
    position: relative;
    padding-bottom: var(--space-3xl);
    padding-left: var(--space-md);
    border-radius: var(--radius-sm);
    transition: background var(--transition-fast);
  }
  .timeline-node:hover {
    background: rgba(255, 255, 255, 0.03);
  }
  .timeline-node:last-child {
    padding-bottom: 0;
  }
  .timeline-dot {
    position: absolute;
    left: -32px;
    top: 4px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 2px solid var(--color-accent);
    background: var(--color-bg);
    transition: box-shadow var(--transition-fast);
  }
  .timeline-node:hover .timeline-dot {
    box-shadow: 0 0 12px var(--color-accent);
  }
  .timeline-year {
    color: var(--color-accent);
    font-size: var(--text-xs);
    display: block;
    margin-bottom: var(--space-xs);
  }
  .timeline-title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }
  .timeline-note {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  /* Photo Strip */
  .photostrip {
    position: relative;
    overflow: hidden;
    padding: var(--space-2xl) 0;
  }
  .photostrip-scroll {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: var(--space-md) var(--space-xl);
    scrollbar-width: none;
  }
  .photostrip-scroll::-webkit-scrollbar {
    display: none;
  }
  .photostrip-scroll img {
    flex: 0 0 auto;
    width: 320px;
    height: 220px;
    object-fit: cover;
    scroll-snap-align: start;
    filter: grayscale(1) contrast(1.05);
    border: 1px solid var(--color-border-subtle);
    transition: filter 200ms var(--ease-out);
  }
  .photostrip-scroll img:hover {
    filter: grayscale(0.7) contrast(1.1);
  }
  .photostrip-noise {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  @media (max-width: 640px) {
    .photostrip-scroll img {
      width: 260px;
      height: 180px;
    }
  }

  /* Contact */
  .contact {
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .contact-shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Contact triangles */
  .contact-tri {
    position: absolute;
    clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
    opacity: 0;
    will-change: transform, opacity;
  }
  .contact-tri--a {
    width: 140px; height: 140px;
    background: rgba(255,255,255,0.06);
    filter: blur(3px);
    top: 10%; left: 5%;
    animation: ctri-a 24s ease-in-out infinite, tri-fade 1s ease 0.4s forwards;
  }
  .contact-tri--b {
    width: 100px; height: 100px;
    background: rgba(255,255,255,0.12);
    filter: blur(1.5px);
    top: 55%; right: 8%;
    animation: ctri-b 18s ease-in-out infinite, tri-fade 1s ease 0.6s forwards;
  }
  .contact-tri--c {
    width: 60px; height: 60px;
    background: rgba(255,255,255,0.2);
    top: 20%; right: 15%;
    animation: ctri-c 14s ease-in-out infinite, tri-fade 1s ease 0.8s forwards;
  }
  .contact-tri--d {
    width: 80px; height: 80px;
    background: rgba(255,255,255,0.14);
    filter: blur(1px);
    bottom: 18%; left: 20%;
    animation: ctri-d 20s ease-in-out infinite, tri-fade 1s ease 1.0s forwards;
  }
  .contact-tri--e {
    width: 45px; height: 45px;
    background: rgba(255,255,255,0.28);
    top: 38%; right: 28%;
    animation: ctri-e 12s ease-in-out infinite, tri-fade 1s ease 0.5s forwards;
  }
  .contact-tri--f {
    width: 50px; height: 50px;
    background: rgba(255,255,255,0.22);
    bottom: 25%; right: 10%;
    animation: ctri-f 16s ease-in-out infinite, tri-fade 1s ease 0.7s forwards;
  }
  .contact-tri--g {
    width: 110px; height: 110px;
    background: rgba(255,255,255,0.07);
    filter: blur(2.5px);
    top: 48%; left: 2%;
    animation: ctri-g 26s ease-in-out infinite, tri-fade 1s ease 0.9s forwards;
  }
  .contact-tri--h {
    width: 30px; height: 30px;
    background: rgba(255,255,255,0.3);
    top: 14%; left: 32%;
    animation: ctri-h 10s ease-in-out infinite, tri-fade 1s ease 1.1s forwards;
  }
  @keyframes ctri-a {
    0%,100% { transform: translate(0,0) rotate(-10deg); }
    25% { transform: translate(20px,-14px) rotate(-4deg); }
    50% { transform: translate(-12px,18px) rotate(-14deg); }
    75% { transform: translate(14px,6px) rotate(-8deg); }
  }
  @keyframes ctri-b {
    0%,100% { transform: translate(0,0) rotate(25deg); }
    33% { transform: translate(-18px,12px) rotate(32deg); }
    66% { transform: translate(10px,-16px) rotate(20deg); }
  }
  @keyframes ctri-c {
    0%,100% { transform: translate(0,0) rotate(-40deg); }
    50% { transform: translate(16px,-18px) rotate(-30deg); }
  }
  @keyframes ctri-d {
    0%,100% { transform: translate(0,0) rotate(18deg); }
    25% { transform: translate(-12px,-8px) rotate(24deg); }
    75% { transform: translate(8px,14px) rotate(14deg); }
  }
  @keyframes ctri-e {
    0%,100% { transform: translate(0,0) rotate(-55deg); }
    33% { transform: translate(8px,10px) rotate(-48deg); }
    66% { transform: translate(-6px,-8px) rotate(-60deg); }
  }
  @keyframes ctri-f {
    0%,100% { transform: translate(0,0) rotate(35deg); }
    50% { transform: translate(-14px,8px) rotate(42deg); }
  }
