---
import Layout from '../layouts/Layout.astro';
import projects from '../content/projects.json';

const categories = [
  { key: 'all', label: 'All' },
  { key: 'fullstack', label: 'Full-Stack' },
  { key: 'ai-ml', label: 'AI / ML' },
  { key: 'systems', label: 'Systems' },
  { key: 'game', label: 'Game' },
  { key: 'tool', label: 'Tool' },
];

const categoryLabels: Record<string, string> = {
  'fullstack': 'FULL-STACK',
  'ai-ml': 'AI/ML',
  'systems': 'SYSTEMS',
  'game': 'GAME',
  'tool': 'TOOL',
};
---
<Layout title="Projects — HyperZx2O">

  <section class="projects-hero section reveal">
    <div class="container">
      <p class="section-tag mono-label">Projects</p>
      <h1 class="display-md">Things I've built</h1>
      <p class="body-lg muted">10 projects. 6 hackathons. A lot of shipping.</p>
    </div>
  </section>

  <section class="projects-list">
    <div class="container">
      <div class="filter-bar" role="toolbar" aria-label="Filter projects by category">
        <div class="filter-indicator"></div>
        {categories.map(cat => (
          <button
            class={`filter-chip mono-label${cat.key === 'all' ? ' active' : ''}`}
            data-category={cat.key}
            aria-pressed={cat.key === 'all'}
          >{cat.label}</button>
        ))}
      </div>
      <div class="sr-only" aria-live="polite" aria-atomic="true" id="filter-status"></div>

      <div class="project-grid stagger">
        {projects.map((project, i) => (
          <article
            class={`project-card stack-hover min-w-0${i % 3 === 0 ? ' project-card--accent' : ''}`}
            data-category={project.category}
          >
            <div class="card-spotlight" aria-hidden="true"></div>
            <div class="project-card-top">
              <span class="project-category mono-label text-truncate">{categoryLabels[project.category]}</span>
              <div class="project-meta">
                {project.fork && <span class="project-fork mono-label">FORK</span>}
                {project.stars > 0 && (
                  <span class="project-stars mono-label">★ <span class="t-digit-group is-animating">{String(project.stars).split('').map((d, i, arr) => <span class="t-digit" data-stagger={i === arr.length - 2 ? '1' : i === arr.length - 1 ? '2' : undefined}>{d}</span>)}</span></span>
                )}
              </div>
            </div>

            <h2 class="project-name heading-3 text-truncate">{project.name}</h2>
            <p class="project-desc text-clamp-3">{project.description}</p>

            <div class="project-tech">
              {project.tech.map(t => (
                <span class="tech-tag mono-label">{t}</span>
              ))}
            </div>

            <div class="project-links">
              <a href={project.github} target="_blank" rel="noopener" class="project-link mono-label">GitHub →</a>
              {project.live && (
                <a href={project.live} target="_blank" rel="noopener" class="project-link mono-label">Live Demo →</a>
              )}
            </div>
          </article>
        ))}
      </div>
      <div class="empty-state" hidden>
        <p>No projects here yet — but I'm probably working on something.</p>
        <p class="empty-state-hint">Try a different filter, or check back soon.</p>
      </div>
    </div>
  </section>

</Layout>

<style>
  .projects-hero .display-md {
    margin-bottom: var(--space-lg);
  }

  /* Filter bar */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-3xl);
    position: relative;
  }
  .filter-indicator {
    position: absolute;
    bottom: 0;
    height: 2px;
    background: var(--color-accent);
    transition: left 0.3s cubic-bezier(0, 0, 0.2, 1), width 0.3s cubic-bezier(0, 0, 0.2, 1);
    pointer-events: none;
  }
  .filter-chip {
    background: transparent;
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
    padding: var(--space-sm) var(--space-lg);
    font-size: var(--text-xs);
    transition: border-color var(--transition-instant), color var(--transition-instant), background var(--transition-instant);
    position: relative;
  }
  .filter-chip:hover,
  .filter-chip.active {
    border-color: var(--color-accent);
    color: var(--color-primary);
    background: var(--color-accent);
  }
  .filter-chip:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Grid */
  .project-grid {
    display: grid;
    gap: var(--space-lg);
  }
  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Card */
  .project-card {
    border: 1px solid var(--color-border-subtle);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    position: relative;
    overflow: hidden;
    perspective: 800px;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition:
      border-color var(--transition-instant),
      transform var(--transition-fast),
      opacity 0.3s ease,
      scale 0.3s ease;
  }
  .project-card[data-hidden="true"] {
    opacity: 0;
    scale: 0.95;
    pointer-events: none;
  }
  .project-card:hover {
    border-color: var(--color-accent);
  }
  .project-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .project-card--accent {
    background: linear-gradient(135deg, rgba(237, 255, 69, 0.03) 0%, transparent 60%);
  }

  /* Cursor spotlight */
  .project-card > .card-spotlight {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(
      500px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(237, 255, 69, 0.06),
      transparent 40%
    );
    pointer-events: none;
    z-index: 0;
  }
  .project-card:hover > .card-spotlight {
    opacity: 1;
  }
  .project-card > * {
    position: relative;
    z-index: 1;
  }

  /* Card top row */
  .project-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .project-category {
    color: var(--color-accent);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
  }
  .project-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }
  .project-fork {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    opacity: 0.6;
  }
  .project-stars {
    color: var(--color-accent);
    font-size: var(--text-xs);
  }

  /* Name */
  .project-name {
    color: var(--color-text);
  }

  /* Description */
  .project-desc {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.65;
    flex: 1;
  }

  /* Tech tags */
  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: auto;
  }

  /* Links */
  .project-links {
    display: flex;
    gap: var(--space-lg);
    padding-top: var(--space-sm);
  }
  .project-link {
    color: var(--color-accent);
    font-size: var(--text-xs);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      animation: none !important;
      transition: border-color var(--transition-instant) !important;
      transform: none !important;
    }
  }
</style>

<script>
  const chips = document.querySelectorAll('.filter-chip');
  const cards = document.querySelectorAll('.project-card');
  const indicator = document.querySelector('.filter-indicator') as HTMLElement;
  const emptyState = document.querySelector('.empty-state') as HTMLElement;

  function moveIndicator(chip: Element) {
    if (!indicator) return;
    const rect = chip.getBoundingClientRect();
    const barRect = chip.parentElement!.getBoundingClientRect();
    indicator.style.left = `${rect.left - barRect.left}px`;
    indicator.style.width = `${rect.width}px`;
  }

  function updateEmptyState() {
    const visibleCards = document.querySelectorAll('.project-card:not([data-hidden="true"])');
    if (emptyState) {
      emptyState.hidden = visibleCards.length > 0;
    }
    const status = document.getElementById('filter-status');
    if (status) {
      status.textContent = visibleCards.length + ' project' + (visibleCards.length !== 1 ? 's' : '') + ' shown';
    }
  }

  // Init indicator on active chip
  const activeChip = document.querySelector('.filter-chip.active');
  if (activeChip) moveIndicator(activeChip);

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      chips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      moveIndicator(chip);

      const category = chip.getAttribute('data-category');
      cards.forEach(card => {
        const cardCategory = card.getAttribute('data-category');
        const show = category === 'all' || cardCategory === category;
        if (show) {
          card.removeAttribute('data-hidden');
          (card as HTMLElement).style.display = '';
        } else {
          card.setAttribute('data-hidden', 'true');
          setTimeout(() => {
            if (card.getAttribute('data-hidden') === 'true') {
              (card as HTMLElement).style.display = 'none';
            }
          }, 300);
        }
      });
      updateEmptyState();
    });
  });

  // Tilt + spotlight
  function applyTilt(e: MouseEvent) {
    const card = e.currentTarget as HTMLElement;
    const rect = card.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const dx = (e.clientX - cx) / (rect.width / 2);
    const dy = (e.clientY - cy) / (rect.height / 2);
    const tiltX = dy * 6;
    const tiltY = -dx * 6;
    card.style.setProperty('--tilt-x', `${tiltX}deg`);
    card.style.setProperty('--tilt-y', `${tiltY}deg`);
    const mx = ((e.clientX - rect.left) / rect.width) * 100;
    const my = ((e.clientY - rect.top) / rect.height) * 100;
    card.style.setProperty('--mouse-x', `${mx}%`);
    card.style.setProperty('--mouse-y', `${my}%`);
  }
  function resetTilt(e: MouseEvent) {
    const card = e.currentTarget as HTMLElement;
    card.style.setProperty('--tilt-x', '0deg');
    card.style.setProperty('--tilt-y', '0deg');
  }
  cards.forEach(card => {
    card.addEventListener('mousemove', applyTilt);
    card.addEventListener('mouseleave', resetTilt);
    card.addEventListener('touchstart', resetTilt);
  });
</script>
