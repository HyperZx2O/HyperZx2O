---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portfolio — HyperZx2O' } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

const fontFaces = `
  @font-face { font-family: 'Sigurd Variable'; src: url('${base}fonts/SigurdVariable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'Courier Prime'; src: url('${base}fonts/CourierPrime-Regular.woff2') format('woff2'); font-weight: 400; font-display: swap; }
  @font-face { font-family: 'Courier Prime'; src: url('${base}fonts/CourierPrime-Bold.woff2') format('woff2'); font-weight: 700; font-display: swap; }
  @font-face { font-family: 'Rules Variable'; src: url('${base}fonts/RulesVariable.woff2') format('woff2'); font-weight: 400 700; font-display: swap; }
`;

const grainCss = `
  .grain-overlay { position: fixed; inset: 0; pointer-events: none; z-index: 1; opacity: 0.035; background-image: url('${base}grain.svg'); background-repeat: repeat; background-size: 200px; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { animation-duration: 0.001s !important; transition-duration: 0.001s !important; } }
`;

const navItems = [
  { label: 'Home', href: base },
  { label: 'Projects', href: `${base}projects/` },
  { label: 'Events', href: `${base}events/` },
  { label: 'Guides', href: `${base}guides/` },
  { label: 'Gallery', href: `${base}gallery/` },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={`${import.meta.env.SITE}${import.meta.env.BASE_URL}og-image.svg`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <title>{title}</title>

  <!-- Preload critical fonts -->
  <link rel="preload" href={`${base}fonts/SigurdVariable.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Fonts: self-hosted woff2 -->
   <style is:inline set:html={fontFaces} />

   <style is:inline>
      /* Lenis smooth scroll */
      html.lenis,
      html.lenis body { height: auto; }
      .lenis:not(.lenis-autoToggle).lenis-stopped { overflow: clip; }
      .lenis [data-lenis-prevent],
      .lenis [data-lenis-prevent-wheel],
      .lenis [data-lenis-prevent-touch],
      .lenis [data-lenis-prevent-vertical],
      .lenis [data-lenis-prevent-horizontal] { overscroll-behavior: contain; }
      .lenis.lenis-smooth iframe { pointer-events: none; }
      .lenis.lenis-autoToggle {
        transition-property: overflow;
        transition-duration: 1ms;
        transition-behavior: allow-discrete;
      }

      /* Hard scroll lock when a modal is open (belt-and-braces behind Lenis stop) */
      html.scroll-locked,
      html.scroll-locked body {
        overflow: hidden;
      }
   </style>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>

  <header class="site-header">
    <nav class="site-nav container">
      <a href={base} class="nav-logo mono-label">HyperZx2O</a>
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
      </button>
      <ul class="nav-links">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { active: currentPath === item.href || (item.href !== base && currentPath.startsWith(item.href)) }]}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a href={`${base}resume.pdf`} download class="nav-cta mono-label">Resume ↓</a>
        </li>
      </ul>
    </nav>
  </header>

  <main id="main-content">
    <slot />
  </main>

  <div class="grain-overlay" aria-hidden="true"></div>

  <!-- First-visit welcome hint -->
  <div class="welcome-hint" id="welcome-hint" hidden>
    <p>Welcome! Use the nav above to explore projects, events, guides, and photos.</p>
    <button class="welcome-dismiss" id="welcome-dismiss" aria-label="Dismiss welcome hint">×</button>
  </div>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-inner">
        <p class="footer-copy mono-label">© 2026 HyperZx2O</p>
        <div class="footer-links">
          <a href="https://github.com/HyperZx2O" target="_blank" rel="noopener">GitHub</a>
          <a href="https://codeforces.com/profile/hyperzx20" target="_blank" rel="noopener">Codeforces</a>
          <a href="https://linkedin.com/in/md-sadman-saif-136b2229b" target="_blank" rel="noopener">LinkedIn</a>
          <a href="mailto:sadman.zarifsaif@gmail.com">Email</a>
        </div>
      </div>
    </div>
  </footer>

  <style is:global>
    @import '../styles/tokens.css';

    /* Skip link */
.skip-link {
      position: fixed;
      top: -100%;
      left: var(--space-md);
      background: var(--color-accent);
      color: var(--color-primary);
      padding: var(--space-xs) var(--space-md);
      font-family: var(--font-mono);
      font-size: var(--text-base);
      font-weight: 700;
      z-index: 1000;
      transition: top var(--transition-fast);
    }
    .skip-link:focus {
      top: var(--space-md);
    }

    /* Header */
    .site-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: rgba(0, 0, 242, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--color-border-subtle);
      transition: transform var(--transition-smooth);
    }
    .site-header.hidden {
      transform: translateY(-100%);
    }

    .site-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 56px;
    }

    .nav-logo {
      font-size: var(--text-sm);
      color: var(--color-accent);
      letter-spacing: 0.1em;
    }

    .nav-toggle {
      display: none;
      flex-direction: column;
      gap: 5px;
      padding: var(--space-xs);
      z-index: 101;
    }
    .nav-toggle span {
      display: block;
      width: 20px;
      height: 2px;
      background: var(--color-text);
      transition: transform var(--transition-fast), opacity var(--transition-fast);
    }
    .nav-toggle[aria-expanded="true"] span:first-child {
      transform: translateY(3.5px) rotate(45deg);
    }
    .nav-toggle[aria-expanded="true"] span:last-child {
      transform: translateY(-3.5px) rotate(-45deg);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: var(--space-xl);
    }

    .nav-link {
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text);
      opacity: 0.7;
      transition: opacity var(--transition-instant), color var(--transition-instant);
    }
    .nav-link:hover,
    .nav-link.active {
      opacity: 1;
      color: var(--color-accent);
    }

    .nav-cta {
      background: var(--color-text);
      color: var(--color-primary);
      padding: var(--space-xs) var(--space-lg);
      font-size: var(--text-xs);
      transition: background var(--transition-instant), color var(--transition-instant);
    }
    .nav-cta:hover {
      background: var(--color-accent);
    }

    /* Mobile nav */
    @media (max-width: 767px) {
      .nav-toggle {
        display: flex;
      }
      .nav-links {
        position: fixed;
        top: 0;
        right: 0;
        width: min(280px, 80vw);
        height: 100dvh;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: var(--space-2xl);
        padding: var(--space-4xl) var(--space-xl);
        background: var(--color-primary);
        border-left: 1px solid var(--color-border-subtle);
        transform: translateX(100%);
        transition: transform 250ms var(--ease-drawer);
      }
      .nav-links[data-open="true"] {
        transform: translateX(0);
      }
      .nav-link {
        font-size: 1rem;
      }
    }

    /* Footer */
    .site-footer {
      border-top: 1px solid var(--color-border-subtle);
      padding-block: var(--space-xl);
    }
    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-md);
    }
    .footer-copy {
      color: var(--color-text-muted);
      font-size: var(--text-xs);
    }
    .footer-links {
      display: flex;
      gap: var(--space-xl);
    }
    .footer-links a {
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-muted);
      transition: color var(--transition-instant);
    }
    .footer-links a:hover {
      color: var(--color-accent);
    }

    /* Page transitions */
    main {
      padding-top: 56px;
    }

    /* Welcome hint */
.welcome-hint {
      position: fixed;
      bottom: 100px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--color-accent);
      color: var(--color-primary);
      padding: var(--space-md) var(--space-xl);
      border-radius: var(--radius-full);
      font-family: var(--font-rules);
      font-size: var(--text-xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      display: flex;
      align-items: center;
      gap: var(--space-md);
      z-index: 100;
      animation: reveal-up 0.5s var(--ease-out) forwards;
    }
    .welcome-hint[hidden] {
      display: none;
    }
    .welcome-dismiss {
      font-size: 1rem;
      line-height: 1;
      opacity: 0.7;
      transition: opacity var(--transition-instant);
    }
    .welcome-dismiss:hover {
      opacity: 1;
    }

  </style>

  <style is:inline set:html={grainCss} />

  <script>
    import Lenis from 'lenis';

    // --- Lenis instance ---
    const lenis = new Lenis({
      autoRaf: true,
      respectReducedMotion: true,
    });

    // Scroll to top on load (avoids scroll restoration flash)
    lenis.scrollTo(0, { immediate: true });

    window.addEventListener('resize', () => lenis.resize());

    // --- Global scroll lock (refcounted) for modals/dialogs ---
    // Stops Lenis AND hard-locks scroll so the background can't move behind
    // open dialogs. Refcount lets multiple stacked locks release cleanly.
    let scrollLockCount = 0;
    (window as any).__lockScroll = function() {
      scrollLockCount++;
      lenis.stop();
      document.documentElement.classList.add('scroll-locked');
    };
    (window as any).__unlockScroll = function() {
      scrollLockCount = Math.max(0, scrollLockCount - 1);
      if (scrollLockCount === 0) {
        lenis.start();
        document.documentElement.classList.remove('scroll-locked');
      }
    };

    // --- Scroll-to-link handling ---
    document.addEventListener('click', (e) => {
      const anchor = (e.target as HTMLElement).closest('a[href]');
      if (!anchor) return;

      const href = anchor.getAttribute('href');
      // Only handle same-origin internal links (not downloads, not external)
      if (!href || href.startsWith('http') || href === '#' || anchor.hasAttribute('download')) return;

      const target = document.querySelector(href);
      if (target) {
        e.preventDefault();
        lenis.scrollTo(target as HTMLElement, { offset: -56 });
      }
    });

    // --- Header hide/show on scroll ---
    const header = document.querySelector('.site-header') as HTMLElement;
    let lastScroll = 0;
    const SCROLL_THRESHOLD = 10;

    lenis.on('scroll', ({ scroll, velocity }: { scroll: number; velocity: number }) => {
      // Don't hide on mobile when menu is open
      if (links?.getAttribute('data-open') === 'true') return;

      if (Math.abs(velocity) < SCROLL_THRESHOLD) return;

      if (velocity > 0 && scroll > 56) {
        header.classList.add('hidden');
      } else {
        header.classList.remove('hidden');
      }
    });

    // --- Mobile menu: use Lenis stop/start ---
    const toggle = document.querySelector('.nav-toggle');
    const links = document.querySelector('.nav-links');

    function trapMenuFocus(e: KeyboardEvent) {
      if (links?.getAttribute('data-open') !== 'true') return;
      const focusable = Array.from(links.querySelectorAll('a, button')).filter(el => el.offsetParent !== null);
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.key === 'Tab') {
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
      if (e.key === 'Escape') {
        toggle?.click();
      }
    }

    toggle?.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      links?.setAttribute('data-open', String(!expanded));

      if (expanded) {
        lenis.start();
        document.removeEventListener('keydown', trapMenuFocus);
      } else {
        lenis.stop();
        document.addEventListener('keydown', trapMenuFocus);
      }
    });

    // Close on link click (mobile)
    links?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.nav-link')) {
        toggle?.setAttribute('aria-expanded', 'false');
        links.setAttribute('data-open', 'false');
        lenis.start();
      }
    });

    // --- Scroll reveal ---
    const revealEls = document.querySelectorAll('.reveal, .stagger');
    if (revealEls.length) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.15 });
      revealEls.forEach(el => io.observe(el));
    }

    // --- Welcome hint (first visit only) ---
    const welcomeHint = document.getElementById('welcome-hint');
    const welcomeDismiss = document.getElementById('welcome-dismiss');
    if (welcomeHint && !localStorage.getItem('portfolio-welcome-seen')) {
      welcomeHint.hidden = false;
      welcomeDismiss?.addEventListener('click', () => {
        welcomeHint.hidden = true;
        localStorage.setItem('portfolio-welcome-seen', 'true');
      });
    }

    // --- Shared tilt + spotlight (used by all pages) ---
    (window as any).applyTilt = function(e: MouseEvent) {
      const card = e.currentTarget as HTMLElement;
      const rect = card.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dx = (e.clientX - cx) / (rect.width / 2);
      const dy = (e.clientY - cy) / (rect.height / 2);
      card.__tiltTarget = { x: `${dy * 6}deg`, y: `${-dx * 6}deg` };
      const mx = ((e.clientX - rect.left) / rect.width) * 100;
      const my = ((e.clientY - rect.top) / rect.height) * 100;
      card.style.setProperty('--mouse-x', `${mx}%`);
      card.style.setProperty('--mouse-y', `${my}%`);
    };
    (window as any).resetTilt = function(e: MouseEvent) {
      const card = e.currentTarget as HTMLElement;
      card.__tiltTarget = { x: '0deg', y: '0deg' };
    };

    // Spring-driven tilt (velocity-aware + interruptible). Each axis is an
    // independent critically-damped spring: stiffness + damping shape the
    // feel, and velocity is carried through target changes so a reversal
    // (e.g. flicking out of the card) decelerates fluidly instead of snapping.
    const tiltCards = Array.from(document.querySelectorAll<HTMLElement>(
      '.featured-card, .cp-card, .devcard, .project-card, .guide-card, .timeline-card'
    ));
    interface TiltState {
      x: string;
      y: string;
    }
    interface SpringState {
      pos: number;
      vel: number;
    }
    const stiffness = 170;   // responsiveness
    const damping = 18;      // 0.75 * 2*sqrt(stiffness) ≈ critical damping (~fluid, no overshoot)
    const springState = new WeakMap<HTMLElement, { x: SpringState; y: SpringState }>();
    function parseDeg(v: string): number {
      return parseFloat(v) || 0;
    }
    function springStep(s: SpringState, target: number, dt: number) {
      const a = (-stiffness * (s.pos - target)) - (damping * s.vel);
      s.vel += a * dt;
      s.pos += s.vel * dt;
    }
    let tiltRaf = 0;
    let lastTiltT = performance.now();
    function tiltLoop() {
      const now = performance.now();
      const dt = Math.min((now - lastTiltT) / 1000, 0.05); // clamp sub-steps
      lastTiltT = now;
      let anyActive = false;
      tiltCards.forEach(card => {
        const target = (card as any).__tiltTarget as TiltState | undefined;
        const state = springState.get(card);
        if (!state) {
          springState.set(card, {
            x: { pos: parseDeg(card.style.getPropertyValue('--tilt-x')), vel: 0 },
            y: { pos: parseDeg(card.style.getPropertyValue('--tilt-y')), vel: 0 }
          });
          return;
        }
        const tx = parseDeg((target as any)?.x);
        const ty = parseDeg((target as any)?.y);
        springStep(state.x, tx || 0, dt);
        springStep(state.y, ty || 0, dt);
        if (Math.abs(state.x.pos - tx) > 0.01 || Math.abs(state.y.pos - ty) > 0.01) {
          anyActive = true;
        }
        card.style.setProperty('--tilt-x', `${state.x.pos}deg`);
        card.style.setProperty('--tilt-y', `${state.y.pos}deg`);
      });
      // Run continuously while any spring is in motion; pause when settled
      if (anyActive) {
        tiltRaf = requestAnimationFrame(tiltLoop);
      } else {
        tiltRaf = 0;
      }
    }
    function startTiltLoop() {
      if (!tiltRaf) {
        lastTiltT = performance.now();
        tiltRaf = requestAnimationFrame(tiltLoop);
      }
    }
    // Kick the spring loop whenever a target is set or reset
    const origApply = (window as any).applyTilt;
    (window as any).applyTilt = function(e: MouseEvent) {
      origApply.call(this, e);
      startTiltLoop();
    };
    const origReset = (window as any).resetTilt;
    (window as any).resetTilt = function(e: MouseEvent) {
      origReset.call(this, e);
      startTiltLoop();
    };
  </script>
</body>
</html>
